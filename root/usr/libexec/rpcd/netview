#!/bin/sh
#
# luci-app-netview -- rpcd backend
#
# Exposes ubus object "netview" with these methods:
#   interfaces      -> per-interface realtime rx/tx rate + lifetime counters,
#                      plus WAN addressing details and the connected-client count
#   devices         -> per-LAN-client traffic aggregated from nf_conntrack,
#                      including a per-application breakdown when OAF is around
#   sessions        -> connection table occupancy + remote-port breakdown
#   features        -> OAF signature database version and the online catalogue
#   feature_update  -> start an OAF signature download + install
#
# OAF is optional throughout: every method above answers without it, and the
# ones that use it say which link in the chain is missing.
#
# Target: ImmortalWrt / OpenWrt 21.02 .. 24.10  (developed for 24.10 x86/64)
#

. /usr/share/libubox/jshn.sh

WORKDIR="/tmp/netview"
STATE_IF="$WORKDIR/if.state"
STATE_DEV="$WORKDIR/dev.state"
TMP_SNAP="$WORKDIR/if.snap"
TMP_IF="$WORKDIR/if.diff"
TMP_RAW="$WORKDIR/dev.raw"
TMP_DEV="$WORKDIR/dev.diff"
TMP_PORT="$WORKDIR/svc.list"
TMP_APPMAP="$WORKDIR/oaf.apps"
TMP_APPRAW="$WORKDIR/app.raw"
TMP_APPFIN="$WORKDIR/app.fin"
TMP_DEVF="$WORKDIR/dev.fin"
TMP_FEAT="$WORKDIR/feat.list"

mkdir -p "$WORKDIR"

# ---------------------------------------------------------------- helpers ---

# Dump /proc/net/dev as:  <ifname> <rx_bytes> <tx_bytes>
snapshot_if() {
	awk 'NR > 2 {
		gsub(":", "", $1)
		if ($1 == "lo") next
		printf "%s %s %s\n", $1, $2, $10
	}' /proc/net/dev
}

# Resolve the L3 device behind a logical netifd interface (wan / lan).
# jshn is used rather than jsonfilter: it is already loaded for output, so this
# keeps the package free of an extra dependency.
l3_device() {
	local iface="$1" dev out
	out=$(ifstatus "$iface" 2>/dev/null)
	if [ -n "$out" ]; then
		json_init
		json_load "$out"
		json_get_var dev l3_device
	fi
	[ -n "$dev" ] || dev=$(uci -q get network."$iface".device)
	[ -n "$dev" ] || dev=$(uci -q get network."$iface".ifname)
	printf '%s' "$dev"
}

# Physical NIC or pure software interface? A real NIC carries a symlink at
# /sys/class/net/<dev>/device pointing at its bus device; ppp, tun, wireguard
# and bridges have no such node.
if_kind() {
	[ -e "/sys/class/net/$1/device" ] && { printf 'physical'; return; }
	printf 'virtual'
}

# Negotiated link speed in Mbit/s; 0 when there is no meaningful link rate.
#
# Only physical NICs are asked directly. Software interfaces get no vote: a
# tun / wireguard device has no phy to negotiate with, and several kernels
# answer /sys/class/net/<dev>/speed with the ethtool default (1000) instead of
# an error -- reading it blindly made OpenClash's utun claim a gigabit link.
# A bridge is the one virtual device with a real answer, and that answer
# belongs to a member port, so bridges fall back to brif/ below.
if_speed() {
	local dev="$1" s m
	if [ -e "/sys/class/net/$dev/device" ]; then
		s=$(cat "/sys/class/net/$dev/speed" 2>/dev/null)
		case "$s" in
			''|*[!0-9]*) ;;
			*) [ "$s" -gt 0 ] && { printf '%s' "$s"; return; } ;;
		esac
	fi
	for m in /sys/class/net/"$dev"/brif/*; do
		[ -e "$m" ] || continue
		s=$(cat "$m/speed" 2>/dev/null)
		case "$s" in
			''|*[!0-9]*) continue ;;
		esac
		[ "$s" -gt 0 ] && { printf '%s' "$s"; return; }
	done
	printf '0'
}

if_operstate() {
	local s
	s=$(cat "/sys/class/net/$1/operstate" 2>/dev/null)
	printf '%s' "${s:-unknown}"
}

# Is the link usable right now?
#
# operstate alone is not enough. The kernel only drives operstate to "up" for
# drivers that report carrier the ethernet way; point-to-point devices -- PPP
# (pppoe-wan), tun (OpenClash's utun), wireguard (AmneziaWG) -- stay at
# "unknown" for their whole life. Judging by operstate alone therefore painted
# every one of them as "not connected" even while they were carrying traffic.
#
# So look at the IFF_* flags ip reports instead:
#   UP        interface has been brought up (ip link set up)
#   LOWER_UP  the driver considers the link viable (== IFF_RUNNING)
# Both set means up. UP without LOWER_UP means the device is enabled but no
# link has come up yet (cable out, peer not negotiating); tunnels do not always
# raise LOWER_UP, so fall back to "does it hold a global address" -- an address
# is only assigned once the interface is actually working.
if_link() {
	local dev="$1" f
	f=$(ip -o link show dev "$dev" 2>/dev/null \
		| awk 'NR == 1 && match($0, /<[^>]*>/) {
			print substr($0, RSTART + 1, RLENGTH - 2)
		}')
	case ",$f," in
		*,UP,*) ;;
		*) printf 'down'; return ;;
	esac
	case ",$f," in
		*,LOWER_UP,*) printf 'up'; return ;;
	esac
	ip -o addr show dev "$dev" scope global 2>/dev/null | grep -q . && {
		printf 'up'; return
	}
	printf 'down'
}

# "192.168.9.231/24" for the first global address of a device, empty if none.
addr_of() {
	local dev="$1" fam="$2"
	ip -"$fam" -o addr show dev "$dev" scope global 2>/dev/null | awk 'NR == 1 { print $4 }'
}

# Classify an interface name into WAN / LAN / ""
if_role() {
	local name="$1" wan="$2" lan="$3"
	if [ -n "$wan" ] && [ "$name" = "$wan" ]; then
		echo "WAN"; return
	fi
	if [ -n "$lan" ] && [ "$name" = "$lan" ]; then
		echo "LAN"; return
	fi
	case "$name" in
		br-lan)              echo "LAN" ;;
		wan|wan6)            echo "WAN" ;;
		pppoe-*|wwan*|usb*)  echo "WAN" ;;
		*)                   echo "" ;;
	esac
}

# All logical roles a device carries, comma separated: "WAN,WAN6" / "LAN".
if_roles() {
	local name="$1" out=""
	[ -n "$2" ] && [ "$name" = "$2" ] && out="${out}WAN,"
	[ -n "$3" ] && [ "$name" = "$3" ] && out="${out}WAN6,"
	[ -n "$4" ] && [ "$name" = "$4" ] && out="${out}LAN,"
	printf '%s' "${out%,}"
}

# -------------------------------------------------------------- conntrack ---

# Connection table paths. Variables rather than literals so the test sandbox
# can aim them at a fake tree.
CT_SYS="/proc/sys/net/netfilter"
CT_TABLE="/proc/net/nf_conntrack"
CT_TABLE_ALT="/proc/net/ip_conntrack"

# "<count> <max>" for the connection table, zeros when nf_conntrack is absent.
ct_limits() {
	local c m
	c=$(cat "$CT_SYS/nf_conntrack_count" 2>/dev/null)
	m=$(cat "$CT_SYS/nf_conntrack_max" 2>/dev/null)
	case "$c" in ''|*[!0-9]*) c=0 ;; esac
	case "$m" in ''|*[!0-9]*) m=0 ;; esac
	printf '%s %s' "$c" "$m"
}

# Aggregate a conntrack table into "<service>\t<count>" lines: the top N, then
# everything else merged into 其他.
#
# Only the *first* dport is read, because the original tuple always points at
# whichever endpoint the packet was addressed to: outbound that is the remote
# service port; inbound -- including anything arriving through a port-forward --
# it is the local one. Either way it answers "what was being reached", which is
# what this panel is for. The reply tuple's dport is the client's ephemeral
# port and carries no information here.
ct_ports() {
	local table="$1"
	[ -r "$table" ] || return 0
	awk '
	function svc(p, pr) {
		if (p == 443) return (pr == "udp") ? "QUIC" : "HTTPS"
		if (p == 80 || p == 8080) return "HTTP"
		if (p == 53) return "DNS"
		if (p == 853) return "DoT"
		if (p == 123) return "NTP"
		if (p == 22) return "SSH"
		if (p == 51820) return "WireGuard"
		if (p == 3478) return "STUN"
		if (p == 5353) return "mDNS"
		if (p == 1900) return "SSDP"
		if (p == 67 || p == 68) return "DHCP"
		if (p == 465 || p == 587 || p == 993 || p == 995) return "邮件"
		return "其他"
	}
	# /proc/net/ip_conntrack has no leading "ipv4" column, so the protocol name
	# is looked up among the fields instead of assumed to sit at $3.
	/^ipv6/ { next }
	/src=/ {
		port = ""; pr = ""
		for (i = 1; i <= NF; i++) {
			v = $i
			if (pr == "" && v ~ /^(tcp|udp|sctp|dccp)$/) pr = v
			else if (port == "" && v ~ /^dport=/) port = substr(v, 7)
		}
		# ICMP and friends carry no port at all; they are still connections.
		cnt[svc(port, pr)]++
	}
	END {
		for (k in cnt) printf "%s\t%d\n", k, cnt[k]
	}
	' "$table" | top_list 5
}

# "<name>\t<count>" lines -> the top N by count, everything else merged into
# 其他, which is always emitted last so the stacked bar has a stable tail.
#
# Selection sort on purpose: the number of distinct names is tiny (services, or
# app categories) so O(n^2) is irrelevant, and it avoids relying on sort(1).
top_list() {
	local top="${1:-5}"
	awk -v top="$top" '
		BEGIN { FS = "\t" }
		{ sum[$1] += $2 + 0 }
		END {
			# 其他 is a bucket, not a member: keep it out of the ranking and
			# fold the tail into whatever it already held.
			rest = 0
			if ("其他" in sum) {
				rest = sum["其他"]
				delete sum["其他"]
			}
			n = 0
			for (k in sum) { n++; key[n] = k; val[n] = sum[k] }
			for (i = 1; i <= n; i++) {
				m = i
				for (j = i + 1; j <= n; j++) if (val[j] > val[m]) m = j
				if (m != i) {
					t = val[i]; val[i] = val[m]; val[m] = t
					t = key[i]; key[i] = key[m]; key[m] = t
				}
			}
			for (i = top + 1; i <= n; i++) rest += val[i]
			for (i = 1; i <= n && i <= top; i++) printf "%s\t%d\n", key[i], val[i]
			if (rest > 0) printf "其他\t%d\n", rest
		}
	'
}

# ---------------------------------------------------------- JSON snippets ---

# Small readers for the JSON that oafd hands back. jshn can build output but
# cannot search a parsed tree by key, and the two daemon generations wrap the
# same payload in different envelopes, so the parsers below walk the quoted
# tokens of each line instead of assuming a path. The two token shapes they
# cope with are  "key":"value"  and  "key":value  (numbers, true/false).

# A JSON string escapes its own quotes, which would otherwise end a token
# early. Only \" is unescaped: it is the only escape these replies use.
# (Defined once per awk program below via jv_unesc.)
#
# First string value stored under <key>, or nothing. The value sits two tokens
# after the key -- the token in between is the colon, in "k":"v" and "k": "v".
json_str() {
	awk -v key="$1" '
		{
			gsub(/\r/, "")
			n = split($0, t, "\"")
			for (i = 1; i <= n; i++) {
				if (want && i == want) { print jv_unesc(t[i]); exit }
				if (t[i] == key && t[i + 1] ~ /^[ \t]*:[ \t]*$/) want = i + 2
			}
		}
		function jv_unesc(s) { gsub(/\\"/, "\"", s); return s }
	'
}

# "<key>\t<value>" for each key named in $1 (space separated), in the order
# they appear. Empty values are kept: "message":"" is an answer, not a miss.
json_flat() {
	awk -v want="$1" '
		BEGIN { n = split(want, w, " "); for (i = 1; i <= n; i++) keep[w[i]] = 1 }
		{
			gsub(/\r/, "")
			c = split($0, t, "\"")
			for (i = 1; i <= c; i++) {
				if (!(t[i] in keep)) continue
				v = jv_tok(t[i + 1], t[i + 2])
				if (found) printf "%s\t%s\n", t[i], jv_unesc(v)
			}
		}
		# A bare value is glued to the colon, and carries whatever structural
		# punctuation follows the field. Only numbers and true/false take this
		# path, so stripping every trailing brace / bracket / comma is safe:
		# "1024}}" is 1024 at the end of a nested object.
		function jv_tok(nx, qv,   v) {
			found = 0
			if (nx ~ /^[ \t]*:[ \t]*$/) { found = 1; return qv }
			if (nx ~ /^[ \t]*:[ \t]*[^ \t]/) {
				v = nx
				sub(/^[ \t]*:[ \t]*/, "", v)
				sub(/[][{},"]+[ \t]*$/, "", v)
				found = 1
				return v
			}
			return ""
		}
		function jv_unesc(s) { gsub(/\\"/, "\"", s); return s }
	'
}

# One key out of json_flat output; empty when the key is absent.
flat_get() {
	printf '%s\n' "$1" | awk -F'\t' -v k="$2" '$1 == k { print $2; exit }'
}

# Truthy when the ubus request payload sets <key> to 1 / true. The payload is
# small and wholly ours, so a literal test beats running a parser over it.
req_flag() {
	case "$1" in
		*"\"$2\":1"*|*"\"$2\": 1"*|*"\"$2\":true"*|*"\"$2\": true"*) echo 1 ;;
		*) echo 0 ;;
	esac
}

# Keep only characters that are safe inside a JSON string. Feature ids, md5
# sums and language tags are all [A-Za-z0-9._-]; dropping everything else also
# means a crafted value cannot break out of the JSON that is handed to ubus.
json_atom() {
	printf '%s' "$1" | tr -cd 'A-Za-z0-9._-'
}

# jshn's json_add_int dies on a non-numeric argument, so anything read out of a
# JSON blob goes through here first.
num_or0() {
	case "$1" in
		''|*[!0-9-]*) echo 0 ;;
		*) echo "$1" ;;
	esac
}

# Size / mtime of a file, 0 when it is not there.
f_size()  { num_or0 "$(stat -c %s "$1" 2>/dev/null)"; }
f_mtime() { num_or0 "$(stat -c %Y "$1" 2>/dev/null)"; }

# The ubus request payload. rpcd hands the method arguments over on stdin;
# invoked by hand, or from the test harness, stdin is a terminal or already at
# EOF and this yields nothing.
oaf_req() {
	local s
	[ -t 0 ] && return 0
	s=$(cat 2>/dev/null)
	case "$s" in
		*'{'*) printf '%s' "$s" ;;
	esac
}

# --------------------------------------------------------- OAF (optional) ---

# OpenAppFilter = kernel module (kmod-oaf) + user-space daemon (appfilter).
# oafd pushes its feature database into the kernel over netlink (id 29, magic
# 0xa0b0c0d0); once DPI matches, the kernel stamps the connection's conntrack
# mark with the application id:
#
#     #define FWX_CT_APPID_MASK 0x0000FFFFU     // oaf/src/fwx_main.c
#     fwx_ct_mark_update(ct, FWX_CT_APPID_MASK, app_id);
#
# That mark is the seam we need. /proc/net/nf_conntrack carries both "mark=" and
# (with accounting on) "bytes=", so joining the two gives real per-application
# byte counts -- which OAF's own ubus API cannot provide, since every field it
# reports is a duration (first_time / latest_time), never a byte counter.
#
#   bytes    <- conntrack (needs nf_conntrack_acct=1)
#   app_id   <- low 16 bits of the mark
#   app name <- oafd's ubus class_list, the only place names exist: the kernel
#               keeps app_id only (/proc/net/af_conn has no name column, nor does
#               /proc/net/af_active_app), and the database itself
#               (/etc/fwxd/feature.bin) is encrypted behind a CRC header.
#
# kmod-oaf on its own is NOT enough: with no oafd pushing the database the
# kernel has nothing to match against.
#
# The module's own proc entries, all under /proc/net. An earlier revision probed
# /proc/sys/oaf/enable, which oaf.ko never creates -- oaf_ready() was therefore
# false on every real router. The test sandbox had been built to match that
# mistake, so nothing caught it; the fake tree now mirrors the real node names.
OAF_MOD_PROCS="/proc/net/af_active_app /proc/net/af_conn /proc/net/af_client"
OAF_TTL=600

# Two daemon generations are in the wild, with different object names *and*
# different reply envelopes:
#
#   old  one ubus method per call, payload returned flat
#        ubus call appfilter class_list
#        -> {"class_list":[{"name":"视频","app_list":["1001,YouTube,1"]}]}
#
#   new  a single "common" router keyed by "api", payload wrapped in an
#        envelope (2000 = ok, 4000 = error)
#        ubus call fwx common '{"CopyRight":"…","api":"class_list","data":{}}'
#        -> {"code":2000,"data":{"class_list":[…]},"CopyRight":"…"}
#
# The newer router validates CopyRight for class_list only, and answers an
# error without it, so the field goes into every request. Nothing below assumes
# an envelope: replies are parsed by walking their quoted tokens, which is why
# one set of parsers covers both generations.
OAF_OBJ_NEW="fwx"
OAF_OBJ_OLD="appfilter"
OAF_COPYRIGHT="www.fanchmwrt.com"

# Where the signature database and its update channel keep their state.
OAF_FEATURE_FILE="/etc/fwxd/feature.bin"
OAF_FEATURE_LIST="/etc/fwxd/feature_list.json"
OAF_TOKEN_UCI="fwx.global.feature_token"

# Has oaf.ko been loaded?
oaf_mod() {
	local p
	for p in $OAF_MOD_PROCS; do
		[ -e "$p" ] && return 0
	done
	return 1
}

# Which daemon generation is answering? new / old / none
#
# Not memoised on purpose: the answer has to change as soon as the user
# installs or removes OAF, and each probe is one local ubus query.
oaf_gen() {
	if ubus -v list "$OAF_OBJ_NEW" 2>/dev/null | grep -q '"common"'; then
		echo new
	elif ubus -v list "$OAF_OBJ_OLD" 2>/dev/null | grep -q '"class_list"'; then
		echo old
	else
		echo none
	fi
}

# Module loaded *and* daemon answering. Deliberately does not test
# /tmp/feature.cfg: nothing in the OAF tree ever writes that file (the
# kernel-side load_feature_buf_from_file is dead code, never called), so
# requiring it would make this permanently false.
oaf_ready() {
	oaf_mod || return 1
	command -v ubus >/dev/null 2>&1 || return 1
	[ "$(oaf_gen)" != "none" ] || return 1
	return 0
}

# Call one OAF API. Prints the raw JSON reply, or nothing when the installed
# generation does not have that API -- the old one has no update APIs at all.
oaf_api() {
	local api="$1" data="{}"
	[ -n "${2:-}" ] && data="$2"
	if [ "$(oaf_gen)" = "old" ]; then
		ubus call "$OAF_OBJ_OLD" "$api" '{}' 2>/dev/null
	else
		ubus call "$OAF_OBJ_NEW" common \
			"{\"CopyRight\":\"$OAF_COPYRIGHT\",\"api\":\"$api\",\"data\":$data}" 2>/dev/null
	fi
}

# Fetch appid -> "<class>\t<name>" and write the cache.
#
# class_list replies, in both generations:
#   {"class_list":[{"name":"视频","app_list":["1001,YouTube,1"]}, ...]}
# The trailing icon flag is present in some builds, absent in others.
oaf_map_fetch() {
	local json
	json=$(oaf_api class_list)
	[ -n "$json" ] || return 1

	printf '%s\n' "$json" | awk -v now="$(date +%s)" '
		BEGIN { printf "%s\n", now }
		{
			gsub(/\r/, "")
			n = split($0, t, "\"")
			for (i = 1; i <= n; i++) {
				s = t[i]
				# "name" appears only on classes: an application is a bare
				# string "1001,YouTube,1" with no "name" key of its own.
				# The value sits two tokens on -- the token in between is the
				# colon, in both "name":"x" and "name": "x".
				if (s == "name" && t[i + 1] ~ /^[ \t]*:/) { want = i + 2; continue }
				if (i == want) { cls = s; want = 0; continue }
				if (s ~ /^[0-9]+,/) {
					k = index(s, ",")
					id = substr(s, 1, k - 1)
					nm = substr(s, k + 1)
					sub(/,[01]$/, "", nm)      # drop the trailing icon flag
					if (id != "" && nm != "")
						printf "%s\t%s\t%s\n", id, cls, nm
				}
			}
		}
	' > "$TMP_APPMAP.tmp" 2>/dev/null

	# A failed parse leaves just the timestamp line behind; keep the old cache.
	if [ "$(wc -l < "$TMP_APPMAP.tmp")" -gt 1 ]; then
		mv -f "$TMP_APPMAP.tmp" "$TMP_APPMAP"
	else
		rm -f "$TMP_APPMAP.tmp"
		return 1
	fi
	return 0
}

# The online catalogue -> one line per entry:
#   id \t version \t type \t free \t count \t date \t md5 \t desc
#
# oafd's normalizer emits each entry as a flat object led by its id, so a new
# id ends the previous record -- that is the rule that actually does the work,
# because a compact reply glues the closing brace to the value before it. A
# standalone "}" also closes one, which keeps a plain {"a":"b"} shape working.
# Entries with no id are dropped, matching what the daemon itself keeps.
# desc is last because it is the only free-text field.
feat_files() {
	awk '
		BEGIN { n = split("id version type free count date md5 desc", w, " "); for (i = 1; i <= n; i++) keep[w[i]] = 1 }
		{
			gsub(/\r/, "")
			c = split($0, t, "\"")
			for (i = 1; i <= c; i++) {
				if (t[i] == "}") { emit(); clear(); continue }
				if (!(t[i] in keep)) continue
				v = jv_tok(t[i + 1], t[i + 2])
				if (!found) continue
				if (t[i] == "id") { emit(); clear() }
				val[t[i]] = jv_unesc(v)
				if (t[i] == "id") id = val["id"]
			}
		}
		END { emit() }
		function emit() {
			if (id == "") return
			printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", id, val["version"], val["type"], \
			       val["free"], val["count"], val["date"], val["md5"], val["desc"]
		}
		function clear(  k) { for (k in val) delete val[k]; id = "" }
		function jv_tok(nx, qv,   v) {
			found = 0
			if (nx ~ /^[ \t]*:[ \t]*$/) { found = 1; return qv }
			if (nx ~ /^[ \t]*:[ \t]*[^ \t]/) {
				v = nx
				sub(/^[ \t]*:[ \t]*/, "", v)
				sub(/[][{},"]+[ \t]*$/, "", v)
				found = 1
				return v
			}
			return ""
		}
		function jv_unesc(s) { gsub(/\\"/, "\"", s); return s }
	'
}

# Refresh the cache when stale. Line 1 holds the build time; a 10 minute TTL
# keeps this off the 3-second poll the UI runs at.
oaf_appmap() {
	local now stamp
	now=$(date +%s)

	if [ -s "$TMP_APPMAP" ] && [ "$(wc -l < "$TMP_APPMAP")" -gt 1 ]; then
		stamp=$(sed -n '1p' "$TMP_APPMAP")
		case "$stamp" in '' | *[!0-9]*) stamp=0 ;; esac
		[ $((now - stamp)) -lt "$OAF_TTL" ] && return 0
	fi

	oaf_ready || return 0
	oaf_map_fetch || return 0
}

# "<ip>\t<appid>\t<up>\t<down>" for every connection OAF has identified.
#
# Same direction rule as the device ranking: the original tuple starts at the
# client, so for a forwarded inbound connection the byte counters swap sides.
ct_apps() {
	awk '
	function ispriv(ip) {
		if (ip ~ /^192\.168\./) return 1
		if (ip ~ /^10\./) return 1
		if (ip ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) return 1
		return 0
	}
	function hx(s,   i, c, d, r) {
		sub(/^0x/, "", s)
		r = 0
		for (i = 1; i <= length(s); i++) {
			d = index("0123456789abcdef", tolower(substr(s, i, 1))) - 1
			if (d < 0) break
			r = r * 16 + d
		}
		return r
	}
	/^ipv6/ { next }
	/src=/ {
		s1 = ""; d1 = ""; b1 = 0; b2 = 0; n = 0; m = 0; mk = -1
		for (i = 1; i <= NF; i++) {
			v = $i
			if (v ~ /^src=/) { n++; if (n == 1) s1 = substr(v, 5) }
			else if (v ~ /^dst=/) { if (n == 1) d1 = substr(v, 5) }
			else if (v ~ /^bytes=/) {
				m++
				t = substr(v, 7) + 0
				if (m == 1) b1 = t
				else if (m == 2) b2 = t
			}
			else if (v ~ /^mark=/ && mk < 0) {
				t = substr(v, 6)
				mk = (t ~ /^0x/) ? hx(t) : t + 0
			}
		}
		# Low 16 bits carry the app id; 0 means OAF has not classified this one.
		app = mk % 65536
		if (app <= 0) next
		if (s1 != "" && ispriv(s1))      { u[s1 "\t" app] += b1; d[s1 "\t" app] += b2 }
		else if (d1 != "" && ispriv(d1)) { u[d1 "\t" app] += b2; d[d1 "\t" app] += b1 }
	}
	END { for (k in u) printf "%s\t%d\t%d\n", k, u[k], d[k] }
	' "$1"
}

# Swap app ids for names, then keep the top N per device by up+down.
# Unknown ids fall back to "#<id>" so they surface instead of silently vanishing.
app_join() {
	awk -F'\t' -v top="${1:-3}" '
		NR == FNR { if (FNR > 1) name[$1] = $3; next }
		{
			nm = ($2 in name) ? name[$2] : ("#" $2)
			gsub(/[|:]/, " ", nm)
			k = $1 "\t" nm
			u[k] += $3
			d[k] += $4
		}
		END {
			for (k in u) {
				split(k, a, "\t")
				ip = a[1]
				n = ++cnt[ip]
				nmv[ip, n] = a[2]
				uv[ip, n] = u[k]
				dv[ip, n] = d[k]
			}
			for (ip in cnt) {
				m = cnt[ip]
				for (i = 1; i <= m; i++) o[i] = i
				# selection sort: avoids depending on sort(1)
				for (i = 1; i <= m; i++) {
					bi = i
					for (j = i + 1; j <= m; j++)
						if (uv[ip, o[j]] + dv[ip, o[j]] > uv[ip, o[bi]] + dv[ip, o[bi]]) bi = j
					t = o[i]; o[i] = o[bi]; o[bi] = t
				}
				lim = (m < top) ? m : top
				for (i = 1; i <= lim; i++)
					printf "%s\t%s\t%d\t%d\n", ip, nmv[ip, o[i]], uv[ip, o[i]], dv[ip, o[i]]
			}
		}
	' "$TMP_APPMAP" "$TMP_APPRAW"
}

# ------------------------------------------------------------- interfaces ---

do_interfaces() {
	local now wan lan wan6 clients wip wproto wuptime wup connected
	local w4 w_ip4 w_mask4 w_ip6 w_gw w_dns w_dnsauto dnsfile peers

	now=$(date +%s)
	wan=$(l3_device wan)
	lan=$(l3_device lan)
	wan6=$(l3_device wan6)
	[ -n "$lan" ] || lan="br-lan"

	snapshot_if > "$TMP_SNAP"

	# Rate = (bytes_now - bytes_prev) / (t_now - t_prev)
	if [ -s "$STATE_IF" ]; then
		awk -v now="$now" -v have=1 '
		NR == FNR {
			if (FNR == 1) { prevt = $1 + 0; next }
			prx[$1] = $2 + 0
			ptx[$1] = $3 + 0
			next
		}
		{
			dt = now - prevt
			if (dt <= 0) dt = 1
			rx = $2 - prx[$1]; if (rx < 0) rx = 0
			tx = $3 - ptx[$1]; if (tx < 0) tx = 0
			printf "%s %s %s %.2f %.2f\n", $1, $2, $3, rx / dt, tx / dt
		}' "$STATE_IF" "$TMP_SNAP" > "$TMP_IF"
	else
		awk '{ printf "%s %s %s 0.00 0.00\n", $1, $2, $3 }' "$TMP_SNAP" > "$TMP_IF"
	fi

	# Persist this sample for the next round
	{ echo "$now"; cat "$TMP_SNAP"; } > "$STATE_IF"

	# ---- WAN details -------------------------------------------------------
	# Everything below is gathered *before* json_init() opens the output
	# document: jshn keeps its state in global shell variables, so an inner
	# json_load() would otherwise clobber the object under construction.
	wup=""; wproto=""; wuptime=""
	if [ -n "$wan" ]; then
		local j
		j=$(ifstatus wan 2>/dev/null)
		if [ -n "$j" ]; then
			json_init
			json_load "$j"
			json_get_var wup up
			json_get_var wproto proto
			json_get_var wuptime uptime
		fi
	fi

	connected=0
	[ "$wup" = "1" ] || [ "$wup" = "true" ] && connected=1

	w_ip4=""; w_mask4=""; w_ip6=""; w_gw=""
	if [ -n "$wan" ]; then
		w4=$(addr_of "$wan" 4)
		[ -n "$w4" ] && { w_ip4="${w4%%/*}"; w_mask4="${w4##*/}"; }
		w_ip6=$(addr_of "$wan" 6 | cut -d/ -f1)
		w_gw=$(ip -4 route show default dev "$wan" 2>/dev/null | awk 'NR == 1 { print $3 }')
	fi

	# DNS servers actually handed to dnsmasq by netifd
	dnsfile="/tmp/resolv.conf.d/resolv.conf.auto"
	[ -r "$dnsfile" ] || dnsfile="/tmp/resolv.conf"
	w_dns=$(awk '/^nameserver/ { printf "%s ", $2 }' "$dnsfile" 2>/dev/null)
	w_dns=${w_dns% }

	w_dnsauto=1
	peers=$(uci -q get network.wan.peerdns)
	[ "$peers" = "0" ] && w_dnsauto=0

	# Connected clients = complete ARP entries
	clients=$(awk 'NR > 1 && $3 == "0x2" { print $1 }' /proc/net/arp 2>/dev/null | sort -u | wc -l)
	: "${clients:=0}"

	# ---- emit --------------------------------------------------------------
	json_init
	json_add_int "timestamp" "$now"
	json_add_string "wan" "$wan"
	json_add_string "lan" "$lan"
	json_add_int "clients" "$clients"

	json_add_object "wan_info"
	json_add_boolean "connected" "$connected"
	json_add_int     "uptime" "${wuptime:-0}"
	json_add_string  "proto" "$wproto"
	json_add_string  "device" "$wan"
	json_add_string  "ipv4" "$w_ip4"
	json_add_int     "mask" "${w_mask4:-0}"
	json_add_string  "ipv6" "$w_ip6"
	json_add_string  "gateway" "$w_gw"
	json_add_string  "dns" "$w_dns"
	json_add_boolean "dns_auto" "$w_dnsauto"
	json_close_object

	json_add_array "interfaces"

	while read -r name rx tx drx dtx; do
		[ -n "$name" ] || continue
		json_add_object
		json_add_string "name"  "$name"
		json_add_string "role"  "$(if_role "$name" "$wan" "$lan")"
		json_add_string "roles" "$(if_roles "$name" "$wan" "$wan6" "$lan")"
		json_add_string "state" "$(if_operstate "$name")"
		json_add_string "link"  "$(if_link "$name")"
		json_add_string "kind"  "$(if_kind "$name")"
		json_add_int    "speed" "$(if_speed "$name")"
		json_add_int    "rx" "$rx"
		json_add_int    "tx" "$tx"
		json_add_double "rx_rate" "$drx"
		json_add_double "tx_rate" "$dtx"
		json_close_object
	done < "$TMP_IF"

	json_close_array
	json_dump
}

# ---------------------------------------------------------------- devices ---

do_devices() {
	local now leases ct apps_state oldifs
	now=$(date +%s)

	leases="/tmp/dhcp.leases"
	[ -f "$leases" ] || leases="/dev/null"

	ct="/proc/net/nf_conntrack"
	[ -r "$ct" ] || ct="/proc/net/ip_conntrack"

	if [ ! -r "$ct" ]; then
		json_init
		json_add_int "timestamp" "$now"
		json_add_array "devices"
		json_close_array
		json_add_string "error" "conntrack_unavailable"
		json_dump
		return
	fi

	# Per-flow byte counters only exist while connection tracking accounting is
	# on. Netfilter defaults to acct=0; OpenWrt turns it on through
	# /etc/sysctl.d/11-nf-conntrack.conf (shipped by kmod-nf-conntrack), but the
	# switch is frequently flipped off again by "reduce NAT memory" advice. With
	# it off, conntrack lines carry no bytes= field at all and every device
	# would silently report 0 B -- so say so explicitly instead.
	acct=0
	flows=0
	if grep -qm1 'bytes=' "$ct" 2>/dev/null; then
		acct=1
	fi
	flows=$(grep -c 'src=' "$ct" 2>/dev/null)
	: "${flows:=0}"

	if [ "$acct" = "0" ] && [ "$flows" -gt 0 ]; then
		json_init
		json_add_int "timestamp" "$now"
		json_add_array "devices"
		json_close_array
		json_add_string "error" "conntrack_acct_disabled"
		json_dump
		return
	fi

	# Aggregate conntrack entries per private (LAN side) address.
	# original tuple  = the initiating direction
	# reply tuple     = bytes flowing back
	awk '
	function ispriv(ip) {
		if (ip ~ /^192\.168\./) return 1
		if (ip ~ /^10\./) return 1
		if (ip ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) return 1
		return 0
	}
	FNR == NR {
		if (NF >= 4) { nm[$3] = $4; mc[$3] = $2 }
		next
	}
	# /proc/net/nf_conntrack prefixes IPv4 lines with "ipv4", but the legacy
	# /proc/net/ip_conntrack does not. Matching on src= copes with both while
	# still skipping IPv6 lines, which start with "ipv6".
	/^ipv6/ { next }
	/src=/ {
		s1 = ""; d1 = ""; b1 = 0; b2 = 0; n = 0; m = 0
		for (i = 1; i <= NF; i++) {
			v = $i
			if (v ~ /^src=/) {
				n++
				if (n == 1) s1 = substr(v, 5)
			}
			else if (v ~ /^dst=/) {
				if (n == 1) d1 = substr(v, 5)
			}
			else if (v ~ /^bytes=/) {
				m++
				t = substr(v, 7) + 0
				if (m == 1) b1 = t
				else if (m == 2) b2 = t
			}
		}
		if (s1 != "" && ispriv(s1)) {
			up[s1] += b1; dn[s1] += b2; cn[s1]++
		}
		else if (d1 != "" && ispriv(d1)) {
			up[d1] += b2; dn[d1] += b1; cn[d1]++
		}
	}
	END {
		# "-" placeholder: an empty field would collapse under FS/IFS splitting
		# and shift every following column.
		for (ip in cn)
			printf "%s\t%s\t%d\t%d\t%d\n", ip, (ip in nm && nm[ip] != "" ? nm[ip] : "-"), up[ip], dn[ip], cn[ip]
	}
	' "$leases" "$ct" > "$TMP_RAW"

	# Application breakdown, when OAF is around. Only connections the kernel has
	# stamped with an app id contribute, so the per-app bytes will not add up to
	# the device total -- the remainder is simply traffic nobody classified.
	# apps_state carries the reason when there is nothing to show, so the page
	# can say which link in the chain is missing instead of looking broken.
	apps_state="ok"
	: > "$TMP_APPRAW"
	if ! oaf_ready; then
		apps_state="no_oaf"
	else
		oaf_appmap
		if [ ! -s "$TMP_APPMAP" ] || [ "$(wc -l < "$TMP_APPMAP")" -le 1 ]; then
			apps_state="no_names"
		else
			ct_apps "$ct" > "$TMP_APPRAW"
			[ -s "$TMP_APPRAW" ] || apps_state="no_mark"
		fi
	fi

	: > "$TMP_APPFIN"
	[ -s "$TMP_APPRAW" ] && app_join 3 > "$TMP_APPFIN"

	# Rate = delta against the previous aggregate
	awk -v now="$now" -v st="$STATE_DEV" '
	BEGIN {
		FS = "\t"
		have = 0
		while ((getline l < st) > 0) {
			have = 1
			c++
			if (c == 1) { pt = l + 0; continue }
			split(l, a, "\t")
			pu[a[1]] = a[3] + 0
			pd[a[1]] = a[4] + 0
		}
		dt = now - pt
		if (dt <= 0) dt = 1
	}
	{
		# A client that was not present in the previous sample has no baseline,
		# so its rate is reported as 0 instead of its whole lifetime counter.
		if (have && ($1 in pu)) {
			du = $3 - pu[$1]; if (du < 0) du = 0
			dd = $4 - pd[$1]; if (dd < 0) dd = 0
			ur = du / dt
			dr = dd / dt
		} else {
			ur = 0; dr = 0
		}
		printf "%s\t%s\t%d\t%d\t%.2f\t%.2f\t%d\n", $1, $2, $3, $4, dr, ur, $5
	}
	' "$TMP_RAW" > "$TMP_DEV"

	# Fold each device's app list onto its line as "name:up:down" joined by "|",
	# so the JSON loop below stays a single pass over one file.
	if [ -s "$TMP_APPFIN" ]; then
		awk -F'\t' '
			NR == FNR {
				if ($1 != "") {
					s = ($1 in acc) ? acc[$1] "|" : ""
					acc[$1] = s $2 ":" $3 ":" $4
				}
				next
			}
			{ printf "%s\t%s\n", $0, ($1 in acc) ? acc[$1] : "" }
		' "$TMP_APPFIN" "$TMP_DEV" > "$TMP_DEVF"
	else
		cp "$TMP_DEV" "$TMP_DEVF"
	fi

	{ echo "$now"; cat "$TMP_RAW"; } > "$STATE_DEV"

	json_init
	json_add_int "timestamp" "$now"
	# Why the app column is empty, when it is: no_oaf / no_names / no_mark / ok
	json_add_string "apps_state" "$apps_state"
	json_add_array "devices"

	while IFS="$(printf '\t')" read -r ip host up down dr ur conns apps; do
		[ -n "$ip" ] || continue
		json_add_object
		json_add_string "ip" "$ip"
		json_add_string "host" "$host"
		json_add_int    "up" "$up"
		json_add_int    "down" "$down"
		json_add_double "up_rate" "$ur"
		json_add_double "down_rate" "$dr"
		json_add_int    "conns" "$conns"
		if [ -n "$apps" ]; then
			json_add_array "apps"
			oldifs="$IFS"
			IFS="|"
			for a in $apps; do
				[ -n "$a" ] || continue
				rest="${a#*:}"
				json_add_object
				json_add_string "name" "${a%%:*}"
				json_add_int    "up"   "${rest%%:*}"
				json_add_int    "down" "${rest#*:}"
				json_close_object
			done
			IFS="$oldifs"
			json_close_array
		fi
		json_close_object
	done < "$TMP_DEVF"

	json_close_array
	json_dump
}

# --------------------------------------------------------------- features ---

# Read-only view of the OAF signature database and of the channel that updates
# it. Everything comes from the daemon itself -- the database is encrypted
# (magic + CRC header, FEATURE_HEADER_SIZE = 24 bytes) and is decrypted into
# oafd's memory, so the only thing readable locally is the file's size and date.
#
#   get_feature_info                 version / app count of the loaded database
#   get_feature_online_list          the catalogue. refresh=1 is the only call
#                                    that touches the network; without it the
#                                    daemon serves /etc/fwxd/feature_list.json,
#                                    which is why the 3-second poll is safe
#   get_feature_online_update_status progress of a running download
#
# Only the new generation has this triad. On the old one the page is told so
# instead of being shown empty fields.
feat_current() {
	local flat="$1"
	json_add_object "current"
	json_add_int    "loaded"    "$(num_or0 "$(flat_get "$flat" loaded)")"
	json_add_string "version"   "$(flat_get "$flat" version)"
	json_add_int    "type"      "$(num_or0 "$(flat_get "$flat" type)")"
	json_add_int    "free"      "$(num_or0 "$(flat_get "$flat" free)")"
	json_add_int    "app_count" "$(num_or0 "$(flat_get "$flat" app_count)")"
	json_add_int    "size"      "$(f_size  "$OAF_FEATURE_FILE")"
	json_add_int    "modified"  "$(f_mtime "$OAF_FEATURE_FILE")"
	json_close_object
}

# The update state, shared by `features` and `feature_update`. Fields the
# daemon did not send read as 0 / empty rather than being omitted, so the page
# never has to test for their presence.
feat_update() {
	local flat="$1" k v
	json_add_object "update"
	for k in state stage status_code message id icons_skipped download_total download_now elapsed; do
		v=$(flat_get "$flat" "$k")
		case "$k" in
			state|stage|message|id) json_add_string "$k" "$v" ;;
			*)                     json_add_int    "$k" "$(num_or0 "$v")" ;;
		esac
	done
	json_close_object
}

do_features() {
	local now req refresh gen flat list sflat lflat
	now=$(date +%s)
	req=$(oaf_req)
	refresh=$(req_flag "$req" refresh)

	json_init
	json_add_int "timestamp" "$now"

	gen=$(oaf_gen)
	case "$gen" in
		none)
			# Either the module or the daemon is missing -- a state the
			# device ranking also reports, under the same name.
			json_add_boolean "supported" 0
			json_add_string  "gen" "none"
			json_add_string  "reason" "no_oaf"
			json_dump
			return
			;;
		old)
			json_add_boolean "supported" 0
			json_add_string  "gen" "old"
			json_add_string  "reason" "no_online_api"
			json_dump
			return
			;;
	esac

	json_add_boolean "supported" 1
	json_add_string  "gen" "new"
	# Only whether a token is stored, never the token: it is the only thing
	# authenticating this router against the vendor's update server.
	if [ -n "$(uci -q get "$OAF_TOKEN_UCI" 2>/dev/null)" ]; then
		json_add_boolean "token" 1
	else
		json_add_boolean "token" 0
	fi

	flat=$(oaf_api get_feature_info)
	feat_current "$(printf '%s' "$flat" | json_flat "loaded version type free app_count")"

	# The catalogue. Only a user-triggered check asks for the network round
	# trip, so a poll can never sit on a 2-minute HTTP timeout.
	if [ "$refresh" = "1" ]; then
		list=$(oaf_api get_feature_online_list '{"refresh":1,"lang":"cn"}')
	else
		list=$(oaf_api get_feature_online_list '{"refresh":0}')
	fi

	: > "$TMP_FEAT"
	printf '%s' "$list" | feat_files > "$TMP_FEAT"

	lflat=$(printf '%s' "$list" | json_flat count)
	json_add_object "online"
	json_add_string "version"      "$(printf '%s' "$list" | json_str version)"
	json_add_string "announcement" "$(printf '%s' "$list" | json_str announcement)"
	json_add_int    "count"        "$(num_or0 "$(flat_get "$lflat" count)")"
	json_add_int    "checked"      "$(f_mtime "$OAF_FEATURE_LIST")"
	json_add_array  "files"
	while IFS="$(printf '\t')" read -r fid fver ftype ffree fcnt fdate fmd5 fdesc; do
		[ -n "$fid" ] || continue
		json_add_object
		json_add_string "id"      "$fid"
		json_add_string "version" "$fver"
		json_add_int    "type"    "$(num_or0 "$ftype")"
		json_add_int    "free"    "$(num_or0 "$ffree")"
		json_add_int    "count"   "$(num_or0 "$fcnt")"
		json_add_string "date"    "$fdate"
		json_add_string "md5"     "$fmd5"
		json_add_string "desc"    "$fdesc"
		json_close_object
	done < "$TMP_FEAT"
	json_close_array
	json_close_object

	sflat=$(oaf_api get_feature_online_update_status)
	feat_update "$(printf '%s' "$sflat" | json_flat "state stage status_code message id icons_skipped download_total download_now elapsed")"

	json_dump
}

# Start a download + install, then report the state it landed in. Writes only
# ever happen here, and only because the user clicked.
do_feature_update() {
	local req id md5 gen out flat
	req=$(oaf_req)
	id=$(json_atom "$(printf '%s' "$req" | json_str id)")
	md5=$(json_atom "$(printf '%s' "$req" | json_str md5)")

	json_init
	json_add_int "timestamp" "$(date +%s)"

	gen=$(oaf_gen)
	if [ "$gen" != "new" ]; then
		json_add_boolean "started" 0
		json_add_string  "reason" "no_online_api"
		json_dump
		return
	fi
	if [ -z "$id" ]; then
		json_add_boolean "started" 0
		json_add_string  "reason" "no_id"
		json_dump
		return
	fi

	# md5 lets the daemon verify what it downloaded; only pass it when the
	# catalogue actually carried one.
	if [ -n "$md5" ]; then
		out=$(oaf_api start_feature_online_update \
			"{\"id\":\"$id\",\"lang\":\"cn\",\"md5\":\"$md5\"}")
	else
		out=$(oaf_api start_feature_online_update "{\"id\":\"$id\",\"lang\":\"cn\"}")
	fi

	# A refusal ("already running", "invalid file id") arrives as the envelope's
	# error code plus a message and no state, so both are passed through.
	flat=$(printf '%s' "$out" | json_flat "code status_code message")
	if [ "$(flat_get "$flat" code)" = "2000" ]; then
		json_add_boolean "started" 1
	else
		json_add_boolean "started" 0
		json_add_string  "reason" "$(flat_get "$flat" message)"
	fi

	feat_update "$(printf '%s' "$out" | json_flat \
		"state stage status_code message id icons_skipped download_total download_now elapsed")"

	json_dump
}

# --------------------------------------------------------------- sessions ---

# Connection table occupancy plus a breakdown of what those connections talk to.
#
# Separate from `devices` on purpose: device accounting needs conntrack byte
# counters, which are off unless accounting is enabled, while the occupancy and
# the port breakdown are available either way. Folding them together would make
# the whole panel disappear on routers that disable acct to save memory.
do_sessions() {
	local now ct lim cc cm
	now=$(date +%s)

	lim=$(ct_limits)
	cc="${lim%% *}"
	cm="${lim##* }"

	# Always the port breakdown. "Where did the connections go" is a different
	# question from "which app used the bandwidth" -- the latter lives in the
	# device ranking, built from the OAF conntrack marks.
	ct="$CT_TABLE"
	[ -r "$ct" ] || ct="$CT_TABLE_ALT"
	ct_ports "$ct" > "$TMP_PORT"

	json_init
	json_add_int "timestamp" "$now"
	json_add_int "count" "$cc"
	json_add_int "max"   "$cm"
	json_add_array "services"
	while IFS="$(printf '\t')" read -r name n; do
		[ -n "$name" ] || continue
		json_add_object
		json_add_string "name"  "$name"
		json_add_int    "count" "$n"
		json_close_object
	done < "$TMP_PORT"
	json_close_array
	json_dump
}

