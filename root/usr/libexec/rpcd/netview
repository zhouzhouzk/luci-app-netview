#!/bin/sh
#
# luci-app-netview -- rpcd backend
#
# Exposes ubus object "netview" with two methods:
#   interfaces  -> per-interface realtime rx/tx rate + lifetime counters,
#                  plus WAN addressing details and the connected-client count
#   devices     -> per-LAN-client traffic aggregated from nf_conntrack
#
# Target: ImmortalWrt / OpenWrt 21.02 .. 24.10  (developed for 24.10 x86/64)
#

. /usr/share/libubox/jshn.sh

WORKDIR="/tmp/netview"
STATE_IF="$WORKDIR/if.state"
STATE_DEV="$WORKDIR/dev.state"
TMP_SNAP="$WORKDIR/if.snap"
TMP_IF="$WORKDIR/if.diff"
TMP_RAW="$WORKDIR/dev.raw"
TMP_DEV="$WORKDIR/dev.diff"
TMP_PORT="$WORKDIR/svc.list"
TMP_OAFMAP="$WORKDIR/oaf.map"
TMP_OAFIDS="$WORKDIR/oaf.ids"

mkdir -p "$WORKDIR"

# ---------------------------------------------------------------- helpers ---

# Dump /proc/net/dev as:  <ifname> <rx_bytes> <tx_bytes>
snapshot_if() {
	awk 'NR > 2 {
		gsub(":", "", $1)
		if ($1 == "lo") next
		printf "%s %s %s\n", $1, $2, $10
	}' /proc/net/dev
}

# Resolve the L3 device behind a logical netifd interface (wan / lan).
# jshn is used rather than jsonfilter: it is already loaded for output, so this
# keeps the package free of an extra dependency.
l3_device() {
	local iface="$1" dev out
	out=$(ifstatus "$iface" 2>/dev/null)
	if [ -n "$out" ]; then
		json_init
		json_load "$out"
		json_get_var dev l3_device
	fi
	[ -n "$dev" ] || dev=$(uci -q get network."$iface".device)
	[ -n "$dev" ] || dev=$(uci -q get network."$iface".ifname)
	printf '%s' "$dev"
}

# Physical NIC or pure software interface? A real NIC carries a symlink at
# /sys/class/net/<dev>/device pointing at its bus device; ppp, tun, wireguard
# and bridges have no such node.
if_kind() {
	[ -e "/sys/class/net/$1/device" ] && { printf 'physical'; return; }
	printf 'virtual'
}

# Negotiated link speed in Mbit/s; 0 when there is no meaningful link rate.
#
# Only physical NICs are asked directly. Software interfaces get no vote: a
# tun / wireguard device has no phy to negotiate with, and several kernels
# answer /sys/class/net/<dev>/speed with the ethtool default (1000) instead of
# an error -- reading it blindly made OpenClash's utun claim a gigabit link.
# A bridge is the one virtual device with a real answer, and that answer
# belongs to a member port, so bridges fall back to brif/ below.
if_speed() {
	local dev="$1" s m
	if [ -e "/sys/class/net/$dev/device" ]; then
		s=$(cat "/sys/class/net/$dev/speed" 2>/dev/null)
		case "$s" in
			''|*[!0-9]*) ;;
			*) [ "$s" -gt 0 ] && { printf '%s' "$s"; return; } ;;
		esac
	fi
	for m in /sys/class/net/"$dev"/brif/*; do
		[ -e "$m" ] || continue
		s=$(cat "$m/speed" 2>/dev/null)
		case "$s" in
			''|*[!0-9]*) continue ;;
		esac
		[ "$s" -gt 0 ] && { printf '%s' "$s"; return; }
	done
	printf '0'
}

if_operstate() {
	local s
	s=$(cat "/sys/class/net/$1/operstate" 2>/dev/null)
	printf '%s' "${s:-unknown}"
}

# Is the link usable right now?
#
# operstate alone is not enough. The kernel only drives operstate to "up" for
# drivers that report carrier the ethernet way; point-to-point devices -- PPP
# (pppoe-wan), tun (OpenClash's utun), wireguard (AmneziaWG) -- stay at
# "unknown" for their whole life. Judging by operstate alone therefore painted
# every one of them as "not connected" even while they were carrying traffic.
#
# So look at the IFF_* flags ip reports instead:
#   UP        interface has been brought up (ip link set up)
#   LOWER_UP  the driver considers the link viable (== IFF_RUNNING)
# Both set means up. UP without LOWER_UP means the device is enabled but no
# link has come up yet (cable out, peer not negotiating); tunnels do not always
# raise LOWER_UP, so fall back to "does it hold a global address" -- an address
# is only assigned once the interface is actually working.
if_link() {
	local dev="$1" f
	f=$(ip -o link show dev "$dev" 2>/dev/null \
		| awk 'NR == 1 && match($0, /<[^>]*>/) {
			print substr($0, RSTART + 1, RLENGTH - 2)
		}')
	case ",$f," in
		*,UP,*) ;;
		*) printf 'down'; return ;;
	esac
	case ",$f," in
		*,LOWER_UP,*) printf 'up'; return ;;
	esac
	ip -o addr show dev "$dev" scope global 2>/dev/null | grep -q . && {
		printf 'up'; return
	}
	printf 'down'
}

# "192.168.9.231/24" for the first global address of a device, empty if none.
addr_of() {
	local dev="$1" fam="$2"
	ip -"$fam" -o addr show dev "$dev" scope global 2>/dev/null | awk 'NR == 1 { print $4 }'
}

# Classify an interface name into WAN / LAN / ""
if_role() {
	local name="$1" wan="$2" lan="$3"
	if [ -n "$wan" ] && [ "$name" = "$wan" ]; then
		echo "WAN"; return
	fi
	if [ -n "$lan" ] && [ "$name" = "$lan" ]; then
		echo "LAN"; return
	fi
	case "$name" in
		br-lan)              echo "LAN" ;;
		wan|wan6)            echo "WAN" ;;
		pppoe-*|wwan*|usb*)  echo "WAN" ;;
		*)                   echo "" ;;
	esac
}

# All logical roles a device carries, comma separated: "WAN,WAN6" / "LAN".
if_roles() {
	local name="$1" out=""
	[ -n "$2" ] && [ "$name" = "$2" ] && out="${out}WAN,"
	[ -n "$3" ] && [ "$name" = "$3" ] && out="${out}WAN6,"
	[ -n "$4" ] && [ "$name" = "$4" ] && out="${out}LAN,"
	printf '%s' "${out%,}"
}

# -------------------------------------------------------------- conntrack ---

# Connection table paths. Variables rather than literals so the test sandbox
# can aim them at a fake tree.
CT_SYS="/proc/sys/net/netfilter"
CT_TABLE="/proc/net/nf_conntrack"
CT_TABLE_ALT="/proc/net/ip_conntrack"

# "<count> <max>" for the connection table, zeros when nf_conntrack is absent.
ct_limits() {
	local c m
	c=$(cat "$CT_SYS/nf_conntrack_count" 2>/dev/null)
	m=$(cat "$CT_SYS/nf_conntrack_max" 2>/dev/null)
	case "$c" in ''|*[!0-9]*) c=0 ;; esac
	case "$m" in ''|*[!0-9]*) m=0 ;; esac
	printf '%s %s' "$c" "$m"
}

# Aggregate a conntrack table into "<service>\t<count>" lines: the top N, then
# everything else merged into 其他.
#
# Only the *first* dport is read, because the original tuple always points at
# whichever endpoint the packet was addressed to: outbound that is the remote
# service port; inbound -- including anything arriving through a port-forward --
# it is the local one. Either way it answers "what was being reached", which is
# what this panel is for. The reply tuple's dport is the client's ephemeral
# port and carries no information here.
ct_ports() {
	local table="$1"
	[ -r "$table" ] || return 0
	awk '
	function svc(p, pr) {
		if (p == 443) return (pr == "udp") ? "QUIC" : "HTTPS"
		if (p == 80 || p == 8080) return "HTTP"
		if (p == 53) return "DNS"
		if (p == 853) return "DoT"
		if (p == 123) return "NTP"
		if (p == 22) return "SSH"
		if (p == 51820) return "WireGuard"
		if (p == 3478) return "STUN"
		if (p == 5353) return "mDNS"
		if (p == 1900) return "SSDP"
		if (p == 67 || p == 68) return "DHCP"
		if (p == 465 || p == 587 || p == 993 || p == 995) return "邮件"
		return "其他"
	}
	# /proc/net/ip_conntrack has no leading "ipv4" column, so the protocol name
	# is looked up among the fields instead of assumed to sit at $3.
	/^ipv6/ { next }
	/src=/ {
		port = ""; pr = ""
		for (i = 1; i <= NF; i++) {
			v = $i
			if (pr == "" && v ~ /^(tcp|udp|sctp|dccp)$/) pr = v
			else if (port == "" && v ~ /^dport=/) port = substr(v, 7)
		}
		# ICMP and friends carry no port at all; they are still connections.
		cnt[svc(port, pr)]++
	}
	END {
		for (k in cnt) printf "%s\t%d\n", k, cnt[k]
	}
	' "$table" | top_list 5
}

# "<name>\t<count>" lines -> the top N by count, everything else merged into
# 其他, which is always emitted last so the stacked bar has a stable tail.
#
# Selection sort on purpose: the number of distinct names is tiny (services, or
# app categories) so O(n^2) is irrelevant, and it avoids relying on sort(1).
top_list() {
	local top="${1:-5}"
	awk -v top="$top" '
		BEGIN { FS = "\t" }
		{ sum[$1] += $2 + 0 }
		END {
			# 其他 is a bucket, not a member: keep it out of the ranking and
			# fold the tail into whatever it already held.
			rest = 0
			if ("其他" in sum) {
				rest = sum["其他"]
				delete sum["其他"]
			}
			n = 0
			for (k in sum) { n++; key[n] = k; val[n] = sum[k] }
			for (i = 1; i <= n; i++) {
				m = i
				for (j = i + 1; j <= n; j++) if (val[j] > val[m]) m = j
				if (m != i) {
					t = val[i]; val[i] = val[m]; val[m] = t
					t = key[i]; key[i] = key[m]; key[m] = t
				}
			}
			for (i = top + 1; i <= n; i++) rest += val[i]
			for (i = 1; i <= n && i <= top; i++) printf "%s\t%d\n", key[i], val[i]
			if (rest > 0) printf "其他\t%d\n", rest
		}
	'
}

# --------------------------------------------------------- OAF (optional) ---

# OpenAppFilter identifies applications with a kernel module (kmod-oaf) plus a
# user-space daemon (appfilter). The daemon publishes its results on the ubus
# object "appfilter"; the kernel module leaves /proc/sys/oaf behind.
#
# What OAF does *not* give, and it matters here: every field it reports is a
# duration (first_time / latest_time), never a byte counter, and visit_info
# carries no five-tuple to join back against conntrack. So the honest reading
# of its data is "which apps are in use, on how many devices" -- not "which app
# is eating the bandwidth". Everything below is written to degrade quietly: on
# a router without OAF the caller falls back to port classification.
OAF_PROC="/proc/sys/oaf"
OAF_CFG="/tmp/feature.cfg"

# Usable right now? The module being loaded is not enough on its own -- oafd is
# what answers ubus, and the feature database is what turns appids into names.
oaf_ready() {
	[ -r "$OAF_PROC/enable" ] || return 1
	[ -r "$OAF_CFG" ] || return 1
	command -v ubus >/dev/null 2>&1 || return 1
	ubus -v list appfilter >/dev/null 2>&1 || return 1
	return 0
}

# appid -> "<category>\t<app name>" out of OAF's feature database.
#
# The file is plain text, one application per line under a class banner:
#   #class 视频
#   1001 YouTube:[tcp;;443;youtube.com;;]
#   1002 抖音:[tcp;;443;douyin.com;;]
# which means the id->name->category mapping needs no ubus round-trip at all.
oaf_app_map() {
	local cfg="$1"
	[ -r "$cfg" ] || return 0
	awk -F: '
		/^#class/ {
			cls = $0
			sub(/^#class[ \t]+/, "", cls)
			sub(/[ \t\r]+$/, "", cls)
			next
		}
		/^[ \t]*#/ { next }
		{
			n = split($1, a, /[ \t]+/)
			if (n >= 2 && a[1] ~ /^[0-9]+$/) printf "%s\t%s\t%s\n", a[1], cls, a[2]
		}
	' "$cfg"
}

# "<category>\t<count>" from OAF's visit records.
#
# visit_info holds one entry per app per device, so counting pairs gives "this
# category is in use on N devices" -- which is the closest thing to a traffic
# breakdown OAF can offer.
oaf_classes() {
	local cfg="$1" ids
	oaf_app_map "$cfg" > "$TMP_OAFMAP"
	[ -s "$TMP_OAFMAP" ] || return 0

	# ubus prints the reply as JSON, and appid is the only field needed.
	# Flattening first keeps this independent of key order and nesting.
	ids=$(ubus call appfilter dev_visit_list 2>/dev/null \
		| tr -d ' \t\r\n' \
		| sed 's/"appid":/\n&/g' \
		| sed -n 's/^"appid":\([0-9][0-9]*\).*/\1/p')
	[ -n "$ids" ] || return 0

	printf '%s\n' "$ids" > "$TMP_OAFIDS"
	awk -F'\t' '
		NR == FNR { cls[$1] = $2; next }
		{ c = cls[$1]; if (c != "") n[c]++ }
		END { for (k in n) printf "%s\t%d\n", k, n[k] }
	' "$TMP_OAFMAP" "$TMP_OAFIDS" | top_list 5
}

# ------------------------------------------------------------- interfaces ---

do_interfaces() {
	local now wan lan wan6 clients wip wproto wuptime wup connected
	local w4 w_ip4 w_mask4 w_ip6 w_gw w_dns w_dnsauto dnsfile peers

	now=$(date +%s)
	wan=$(l3_device wan)
	lan=$(l3_device lan)
	wan6=$(l3_device wan6)
	[ -n "$lan" ] || lan="br-lan"

	snapshot_if > "$TMP_SNAP"

	# Rate = (bytes_now - bytes_prev) / (t_now - t_prev)
	if [ -s "$STATE_IF" ]; then
		awk -v now="$now" -v have=1 '
		NR == FNR {
			if (FNR == 1) { prevt = $1 + 0; next }
			prx[$1] = $2 + 0
			ptx[$1] = $3 + 0
			next
		}
		{
			dt = now - prevt
			if (dt <= 0) dt = 1
			rx = $2 - prx[$1]; if (rx < 0) rx = 0
			tx = $3 - ptx[$1]; if (tx < 0) tx = 0
			printf "%s %s %s %.2f %.2f\n", $1, $2, $3, rx / dt, tx / dt
		}' "$STATE_IF" "$TMP_SNAP" > "$TMP_IF"
	else
		awk '{ printf "%s %s %s 0.00 0.00\n", $1, $2, $3 }' "$TMP_SNAP" > "$TMP_IF"
	fi

	# Persist this sample for the next round
	{ echo "$now"; cat "$TMP_SNAP"; } > "$STATE_IF"

	# ---- WAN details -------------------------------------------------------
	# Everything below is gathered *before* json_init() opens the output
	# document: jshn keeps its state in global shell variables, so an inner
	# json_load() would otherwise clobber the object under construction.
	wup=""; wproto=""; wuptime=""
	if [ -n "$wan" ]; then
		local j
		j=$(ifstatus wan 2>/dev/null)
		if [ -n "$j" ]; then
			json_init
			json_load "$j"
			json_get_var wup up
			json_get_var wproto proto
			json_get_var wuptime uptime
		fi
	fi

	connected=0
	[ "$wup" = "1" ] || [ "$wup" = "true" ] && connected=1

	w_ip4=""; w_mask4=""; w_ip6=""; w_gw=""
	if [ -n "$wan" ]; then
		w4=$(addr_of "$wan" 4)
		[ -n "$w4" ] && { w_ip4="${w4%%/*}"; w_mask4="${w4##*/}"; }
		w_ip6=$(addr_of "$wan" 6 | cut -d/ -f1)
		w_gw=$(ip -4 route show default dev "$wan" 2>/dev/null | awk 'NR == 1 { print $3 }')
	fi

	# DNS servers actually handed to dnsmasq by netifd
	dnsfile="/tmp/resolv.conf.d/resolv.conf.auto"
	[ -r "$dnsfile" ] || dnsfile="/tmp/resolv.conf"
	w_dns=$(awk '/^nameserver/ { printf "%s ", $2 }' "$dnsfile" 2>/dev/null)
	w_dns=${w_dns% }

	w_dnsauto=1
	peers=$(uci -q get network.wan.peerdns)
	[ "$peers" = "0" ] && w_dnsauto=0

	# Connected clients = complete ARP entries
	clients=$(awk 'NR > 1 && $3 == "0x2" { print $1 }' /proc/net/arp 2>/dev/null | sort -u | wc -l)
	: "${clients:=0}"

	# ---- emit --------------------------------------------------------------
	json_init
	json_add_int "timestamp" "$now"
	json_add_string "wan" "$wan"
	json_add_string "lan" "$lan"
	json_add_int "clients" "$clients"

	json_add_object "wan_info"
	json_add_boolean "connected" "$connected"
	json_add_int     "uptime" "${wuptime:-0}"
	json_add_string  "proto" "$wproto"
	json_add_string  "device" "$wan"
	json_add_string  "ipv4" "$w_ip4"
	json_add_int     "mask" "${w_mask4:-0}"
	json_add_string  "ipv6" "$w_ip6"
	json_add_string  "gateway" "$w_gw"
	json_add_string  "dns" "$w_dns"
	json_add_boolean "dns_auto" "$w_dnsauto"
	json_close_object

	json_add_array "interfaces"

	while read -r name rx tx drx dtx; do
		[ -n "$name" ] || continue
		json_add_object
		json_add_string "name"  "$name"
		json_add_string "role"  "$(if_role "$name" "$wan" "$lan")"
		json_add_string "roles" "$(if_roles "$name" "$wan" "$wan6" "$lan")"
		json_add_string "state" "$(if_operstate "$name")"
		json_add_string "link"  "$(if_link "$name")"
		json_add_string "kind"  "$(if_kind "$name")"
		json_add_int    "speed" "$(if_speed "$name")"
		json_add_int    "rx" "$rx"
		json_add_int    "tx" "$tx"
		json_add_double "rx_rate" "$drx"
		json_add_double "tx_rate" "$dtx"
		json_close_object
	done < "$TMP_IF"

	json_close_array
	json_dump
}

# ---------------------------------------------------------------- devices ---

do_devices() {
	local now leases ct
	now=$(date +%s)

	leases="/tmp/dhcp.leases"
	[ -f "$leases" ] || leases="/dev/null"

	ct="/proc/net/nf_conntrack"
	[ -r "$ct" ] || ct="/proc/net/ip_conntrack"

	if [ ! -r "$ct" ]; then
		json_init
		json_add_int "timestamp" "$now"
		json_add_array "devices"
		json_close_array
		json_add_string "error" "conntrack_unavailable"
		json_dump
		return
	fi

	# Per-flow byte counters only exist while connection tracking accounting is
	# on. Netfilter defaults to acct=0; OpenWrt turns it on through
	# /etc/sysctl.d/11-nf-conntrack.conf (shipped by kmod-nf-conntrack), but the
	# switch is frequently flipped off again by "reduce NAT memory" advice. With
	# it off, conntrack lines carry no bytes= field at all and every device
	# would silently report 0 B -- so say so explicitly instead.
	acct=0
	flows=0
	if grep -qm1 'bytes=' "$ct" 2>/dev/null; then
		acct=1
	fi
	flows=$(grep -c 'src=' "$ct" 2>/dev/null)
	: "${flows:=0}"

	if [ "$acct" = "0" ] && [ "$flows" -gt 0 ]; then
		json_init
		json_add_int "timestamp" "$now"
		json_add_array "devices"
		json_close_array
		json_add_string "error" "conntrack_acct_disabled"
		json_dump
		return
	fi

	# Aggregate conntrack entries per private (LAN side) address.
	# original tuple  = the initiating direction
	# reply tuple     = bytes flowing back
	awk '
	function ispriv(ip) {
		if (ip ~ /^192\.168\./) return 1
		if (ip ~ /^10\./) return 1
		if (ip ~ /^172\.(1[6-9]|2[0-9]|3[01])\./) return 1
		return 0
	}
	FNR == NR {
		if (NF >= 4) { nm[$3] = $4; mc[$3] = $2 }
		next
	}
	# /proc/net/nf_conntrack prefixes IPv4 lines with "ipv4", but the legacy
	# /proc/net/ip_conntrack does not. Matching on src= copes with both while
	# still skipping IPv6 lines, which start with "ipv6".
	/^ipv6/ { next }
	/src=/ {
		s1 = ""; d1 = ""; b1 = 0; b2 = 0; n = 0; m = 0
		for (i = 1; i <= NF; i++) {
			v = $i
			if (v ~ /^src=/) {
				n++
				if (n == 1) s1 = substr(v, 5)
			}
			else if (v ~ /^dst=/) {
				if (n == 1) d1 = substr(v, 5)
			}
			else if (v ~ /^bytes=/) {
				m++
				t = substr(v, 7) + 0
				if (m == 1) b1 = t
				else if (m == 2) b2 = t
			}
		}
		if (s1 != "" && ispriv(s1)) {
			up[s1] += b1; dn[s1] += b2; cn[s1]++
		}
		else if (d1 != "" && ispriv(d1)) {
			up[d1] += b2; dn[d1] += b1; cn[d1]++
		}
	}
	END {
		# "-" placeholder: an empty field would collapse under FS/IFS splitting
		# and shift every following column.
		for (ip in cn)
			printf "%s\t%s\t%d\t%d\t%d\n", ip, (ip in nm && nm[ip] != "" ? nm[ip] : "-"), up[ip], dn[ip], cn[ip]
	}
	' "$leases" "$ct" > "$TMP_RAW"

	# Rate = delta against the previous aggregate
	awk -v now="$now" -v st="$STATE_DEV" '
	BEGIN {
		FS = "\t"
		have = 0
		while ((getline l < st) > 0) {
			have = 1
			c++
			if (c == 1) { pt = l + 0; continue }
			split(l, a, "\t")
			pu[a[1]] = a[3] + 0
			pd[a[1]] = a[4] + 0
		}
		dt = now - pt
		if (dt <= 0) dt = 1
	}
	{
		# A client that was not present in the previous sample has no baseline,
		# so its rate is reported as 0 instead of its whole lifetime counter.
		if (have && ($1 in pu)) {
			du = $3 - pu[$1]; if (du < 0) du = 0
			dd = $4 - pd[$1]; if (dd < 0) dd = 0
			ur = du / dt
			dr = dd / dt
		} else {
			ur = 0; dr = 0
		}
		printf "%s\t%s\t%d\t%d\t%.2f\t%.2f\t%d\n", $1, $2, $3, $4, dr, ur, $5
	}
	' "$TMP_RAW" > "$TMP_DEV"

	{ echo "$now"; cat "$TMP_RAW"; } > "$STATE_DEV"

	json_init
	json_add_int "timestamp" "$now"
	json_add_array "devices"

	while IFS="$(printf '\t')" read -r ip host up down dr ur conns; do
		[ -n "$ip" ] || continue
		json_add_object
		json_add_string "ip" "$ip"
		json_add_string "host" "$host"
		json_add_int    "up" "$up"
		json_add_int    "down" "$down"
		json_add_double "up_rate" "$ur"
		json_add_double "down_rate" "$dr"
		json_add_int    "conns" "$conns"
		json_close_object
	done < "$TMP_DEV"

	json_close_array
	json_dump
}

# --------------------------------------------------------------- sessions ---

# Connection table occupancy plus a breakdown of what those connections talk to.
#
# Separate from `devices` on purpose: device accounting needs conntrack byte
# counters, which are off unless accounting is enabled, while the occupancy and
# the port breakdown are available either way. Folding them together would make
# the whole panel disappear on routers that disable acct to save memory.
do_sessions() {
	local now ct lim cc cm src
	now=$(date +%s)

	lim=$(ct_limits)
	cc="${lim%% *}"
	cm="${lim##* }"

	# OAF first when it is actually running: an app name beats a port number.
	# Anything short of a populated answer falls through to the ports.
	src="port"
	: > "$TMP_PORT"
	if oaf_ready; then
		oaf_classes "$OAF_CFG" > "$TMP_PORT"
		[ -s "$TMP_PORT" ] && src="oaf"
	fi

	if [ "$src" = "port" ]; then
		ct="$CT_TABLE"
		[ -r "$ct" ] || ct="$CT_TABLE_ALT"
		ct_ports "$ct" > "$TMP_PORT"
	fi

	json_init
	json_add_int "timestamp" "$now"
	json_add_int "count" "$cc"
	json_add_int "max"   "$cm"
	# Lets the UI label the breakdown for what it actually is.
	json_add_string "source" "$src"
	json_add_array "services"
	while IFS="$(printf '\t')" read -r name n; do
		[ -n "$name" ] || continue
		json_add_object
		json_add_string "name"  "$name"
		json_add_int    "count" "$n"
		json_close_object
	done < "$TMP_PORT"
	json_close_array
	json_dump
}

# ------------------------------------------------------------------ entry ---

case "$1" in
	list)
		echo '{ "interfaces": {}, "devices": {}, "sessions": {} }'
		;;
	call)
		case "$2" in
			interfaces) do_interfaces ;;
			devices)    do_devices ;;
			sessions)   do_sessions ;;
			*)          echo '{}' ;;
		esac
		;;
	*)
		echo '{}'
		;;
esac
